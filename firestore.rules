rules_version = '2';

// 크리스마스 30문답 공개판 — Firestore 보안 규칙
//
// 핵심 원칙
//  1) rooms/{rid} 아래 모든 데이터는 그 문답의 memberIds 두 명만 읽고 쓴다.
//  2) 문답은 관리자가 발급한 가입 코드(invites)로만 만들어진다. 한 사람은 문답 하나에만 속한다.
//  3) 짝꿍 코드(pairs)로 한 명만 더 들어올 수 있고, 2명이 차면 더 못 들어온다.
//  4) meta/config 의 closeAt 이 지나면 모든 쓰기가 막힌다(열람·내보내기만 가능).
//  5) 전체 문답 목록 조회(list)는 누구에게도 허용하지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(uid()));
    }
    function roomPath(rid) { return /databases/$(database)/documents/rooms/$(rid); }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function isMember(rid) {
      return signedIn() && uid() in get(roomPath(rid)).data.memberIds;
    }
    // 운영 중인지: 관리자가 일정을 저장했고, 아직 닫히는 시각 전
    function isOpen() {
      return get(/databases/$(database)/documents/meta/config).data.closeAt > request.time;
    }
    function canWrite(rid) { return isMember(rid) && isOpen(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ── 관리자 표시: 콘솔에서만 만든다. 본인 것만 확인 가능 ──
    match /admins/{id} {
      allow get: if signedIn() && uid() == id;
      allow list, write: if false;
    }

    // ── 운영 일정 ──
    match /meta/config {
      allow get: if signedIn();
      allow list: if false;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['start', 'closeAt', 'deleteOn'])
        && request.resource.data.start is string
        && request.resource.data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.closeAt is timestamp
        && request.resource.data.deleteOn is string
        && request.resource.data.deleteOn.size() <= 10;
    }

    // ── 가입 코드: 문서 이름이 곧 코드. 코드를 아는 사람만 하나씩 확인할 수 있다 ──
    match /invites/{code} {
      // 아직 쓰지 않은 코드만 확인할 수 있다. 쓰인 코드는 쓴 사람과 관리자만 (누가 썼는지 남에게 보이지 않게)
      allow get: if signedIn() && (resource == null || resource.data.used == false || resource.data.usedBy == uid() || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['used', 'createdAt'])
        && request.resource.data.used == false;
      allow delete: if isAdmin() && resource.data.used == false;
      // '사용됨' 표시는 같은 묶음(트랜잭션) 안에서 그 코드로 문답이 실제로 만들어질 때만
      allow update: if signedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == uid()
        && request.resource.data.roomId is string
        && changed().hasOnly(['used', 'usedBy', 'usedAt', 'roomId'])
        && !exists(roomPath(request.resource.data.roomId))
        && getAfter(roomPath(request.resource.data.roomId)).data.invite == code
        && getAfter(roomPath(request.resource.data.roomId)).data.owner == uid();
    }

    // ── 짝꿍 코드 ──
    match /pairs/{code} {
      allow get: if signedIn() && (resource == null || resource.data.used == false
        || resource.data.usedBy == uid() || resource.data.createdBy == uid());
      allow list, delete: if false;
      // 혼자 있는 문답의 주인만 만들 수 있고, 만료는 최대 7일(+여유 1시간)
      allow create: if signedIn() && isOpen()
        && request.resource.data.keys().hasOnly(['roomId', 'exp', 'used', 'createdBy'])
        && request.resource.data.used == false
        && request.resource.data.createdBy == uid()
        && request.resource.data.roomId is string
        && request.resource.data.exp is timestamp
        && request.resource.data.exp <= request.time + duration.value(169, 'h')
        && getAfter(roomPath(request.resource.data.roomId)).data.pairCode == code
        && getAfter(roomPath(request.resource.data.roomId)).data.memberIds == [uid()];
      // '사용됨' 표시는 같은 묶음 안에서 실제로 그 문답에 들어갈 때만
      allow update: if signedIn()
        && resource.data.used == false
        && resource.data.exp > request.time
        && request.resource.data.used == true
        && request.resource.data.usedBy == uid()
        && changed().hasOnly(['used', 'usedBy', 'usedAt'])
        && !(uid() in get(roomPath(resource.data.roomId)).data.memberIds)
        && uid() in getAfter(roomPath(resource.data.roomId)).data.memberIds;
    }

    // ── 내 정보: 어느 문답에 속하는지. 한 번 정해지면 바꿀 수 없다 ──
    match /users/{id} {
      allow get: if signedIn() && uid() == id;
      allow list, delete: if false;
      allow create: if signedIn() && uid() == id
        && request.resource.data.keys().hasOnly(['name', 'roomId', 'role', 'ts'])
        && validName(request.resource.data.name)
        && request.resource.data.role in ['owner', 'partner']
        && request.resource.data.roomId is string
        && uid() in getAfter(roomPath(request.resource.data.roomId)).data.memberIds;
      allow update: if signedIn() && uid() == id
        && changed().hasOnly(['name'])
        && validName(request.resource.data.name);
    }

    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 12; }
    // 화면에 그대로 들어가는 값은 형식을 못 박는다 (짝꿍이 콘솔로 이상한 값을 넣어 상대 화면을 망가뜨리지 못하게)
    function isHex(c) { return c is string && c.matches('^#[0-9a-fA-F]{6}$'); }
    function isImgUrl(u) { return u is string && u.size() <= 600 && u.matches('^https://firebasestorage[.]googleapis[.]com/[A-Za-z0-9._~%/?&=+-]*$'); }

    function validRoom(d) {
      // 제목·부제·질문은 모든 문답이 함께 쓰는 값이라 사이트 코드에만 있고, 문답 문서에는 저장하지 않는다
      return d.palette is map
        && d.palette.keys().hasOnly(['bg', 'main'])
        && isHex(d.palette.bg) && isHex(d.palette.main)
        && d.paper in ['cream', 'sand', 'peach', 'rose', 'mint', 'sage', 'sky', 'lilac', 'white', 'warmgray', 'coolgray', 'ash',
                       'mocha', 'wine', 'forest', 'navy', 'terra', 'teal', 'ink', 'charcoal', 'slate']
        && d.fx in ['snow', 'powder', 'bigsnow', 'flake', 'storm', 'blizzard']
        && d.pairCode is string && d.pairCode.size() <= 12
        && d.pairExp is number;
    }

    // ── 문답 ──
    match /rooms/{rid} {
      allow get: if signedIn() && uid() in resource.data.memberIds;
      allow list, delete: if false;

      // 만들기: 쓰지 않은 가입 코드가 있어야 하고, 아직 어떤 문답에도 속하지 않은 사람만
      allow create: if signedIn() && isOpen()
        && request.resource.data.keys().hasOnly(['palette', 'paper', 'fx', 'memberIds', 'owner', 'invite', 'pairCode', 'pairExp', 'ts'])
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.owner == uid()
        && request.resource.data.invite is string
        && validRoom(request.resource.data)
        && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.used == false
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.used == true
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.usedBy == uid()
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.roomId == rid
        && !exists(userPath(uid()))
        && getAfter(userPath(uid())).data.roomId == rid;

      allow update: if memberEdit() || partnerJoin();

      // 멤버가 고칠 수 있는 것: 색·종이·효과, 그리고(혼자일 때) 짝꿍 코드 재발급
      function memberEdit() {
        return signedIn() && uid() in resource.data.memberIds && isOpen()
          && changed().hasOnly(['palette', 'paper', 'fx', 'pairCode', 'pairExp'])
          && validRoom(request.resource.data)
          && (request.resource.data.pairCode == resource.data.pairCode
              || (resource.data.memberIds.size() == 1
                  && !exists(/databases/$(database)/documents/pairs/$(request.resource.data.pairCode))
                  && getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairCode)).data.roomId == rid));
      }

      // 짝꿍 들어오기: 혼자 있는 문답에, 유효한 짝꿍 코드를 같은 묶음에서 '사용됨'으로 바꾸면서, 자기 자신만 추가
      function partnerJoin() {
        return signedIn() && isOpen()
          && !(uid() in resource.data.memberIds)
          && resource.data.memberIds.size() == 1
          && request.resource.data.memberIds == resource.data.memberIds.concat([uid()])
          && changed().hasOnly(['memberIds'])
          && get(/databases/$(database)/documents/pairs/$(resource.data.pairCode)).data.used == false
          && get(/databases/$(database)/documents/pairs/$(resource.data.pairCode)).data.roomId == rid
          && get(/databases/$(database)/documents/pairs/$(resource.data.pairCode)).data.exp > request.time
          && getAfter(/databases/$(database)/documents/pairs/$(resource.data.pairCode)).data.used == true
          && getAfter(/databases/$(database)/documents/pairs/$(resource.data.pairCode)).data.usedBy == uid()
          && !exists(userPath(uid()))
          && getAfter(userPath(uid())).data.roomId == rid;
      }

      // 프로필: 본인 것만
      match /members/{mid} {
        allow read: if isMember(rid);
        allow create, update: if canWrite(rid) && mid == uid()
          && request.resource.data.keys().hasOnly(['name', 'color', 'img'])
          && validName(request.resource.data.name)
          && isHex(request.resource.data.color)
          && (request.resource.data.img == '' || isImgUrl(request.resource.data.img));
        allow delete: if false;
      }

      // 답변: 본인 것만. r = 긴급 송부한 날 {일차: 시각}
      match /answers/{aid} {
        allow read: if isMember(rid);
        allow create, update: if canWrite(rid) && aid == uid()
          && request.resource.data.keys().hasOnly(['a', 'r'])
          && request.resource.data.a is map
          && request.resource.data.a.size() <= 30
          && request.resource.data.get('r', {}) is map
          && request.resource.data.get('r', {}).size() <= 30;
        allow delete: if false;
      }

      // 한마디: 본인 이름으로만 쓰고, 본인 것만 지운다
      match /says/{sid} {
        allow read: if isMember(rid);
        allow create: if canWrite(rid)
          && request.resource.data.keys().hasOnly(['uid', 'text', 'ts'])
          && request.resource.data.uid == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
          && request.resource.data.ts is number;
        allow delete: if canWrite(rid) && resource.data.uid == uid();
        allow update: if false;
      }

      // 우표: 하루에 한 사람당 한 장, 붙이면 못 바꾼다
      match /stamps/{sid} {
        allow read: if isMember(rid);
        allow create: if canWrite(rid)
          && request.resource.data.keys().hasOnly(['day', 'uid', 'img', 'ts'])
          && request.resource.data.uid == uid()
          && request.resource.data.day is int
          && request.resource.data.day >= 1 && request.resource.data.day <= 30
          && sid == 'd' + string(request.resource.data.day) + '_' + uid()
          && isImgUrl(request.resource.data.img)
          && request.resource.data.ts is number;
        allow update, delete: if false;
      }

      // 헤더: 칸이 h1~h4 네 개뿐이라 최대 4장
      match /headers/{hid} {
        allow read: if isMember(rid);
        allow create, update: if canWrite(rid)
          && hid.matches('^h[1-4]$')
          && request.resource.data.keys().hasOnly(['aid', 'y', 'by', 'ts'])
          && isImgUrl(request.resource.data.aid)
          && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 100
          && request.resource.data.by == uid()
          && request.resource.data.ts is number;
        allow delete: if canWrite(rid);
      }

      // 채팅: 1~30일 방에만, 본인 이름으로만. 고치거나 지울 수 없다
      // st = 서버가 받은 시각(정렬용). 넣으려면 반드시 서버 시각이어야 한다
      // af = 보낼 때 화면 맨 아래 글의 정렬 열쇠(숫자). 내가 보낸 글이 이미 보이던 글 위로 가지 않게
      match /chats/{day}/messages/{mid} {
        allow read: if isMember(rid);
        allow create: if canWrite(rid)
          && day.matches('^d([1-9]|[12][0-9]|30)$')
          && request.resource.data.uid == uid()
          && request.resource.data.ts is number
          && (!('st' in request.resource.data) || request.resource.data.st == request.time)
          && (!('af' in request.resource.data) || request.resource.data.af is number)
          && (
            (request.resource.data.keys().hasOnly(['uid', 'text', 'ts', 'st', 'af'])
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500)
            ||
            (request.resource.data.keys().hasOnly(['uid', 'dice', 'v', 'ts', 'st', 'af'])
              && request.resource.data.dice in [6, 10, 100]
              && request.resource.data.v is int
              && request.resource.data.v >= 1 && request.resource.data.v <= request.resource.data.dice)
          );
        allow update, delete: if false;
      }
    }

    // 그 밖의 모든 경로는 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
